o referencia;\n  · también se guarda el cambio de 30 días en el extremo este (90–82° O): si sube, todavía llega agua caliente a la costa.\nVerificación: cuando el nivel del mar en 90–82° O baje ≥ 4 cm en 30 días, se anota la fecha real y se compara con la\nllegada que se estimó cada día antes (3 días seguidos bajo el umbral). Ojo: la \"sla\" incluye el ciclo de las estaciones del\naño, así que una bajada de 4 cm puede ser estacional; y cuando el frente está quieto la velocidad medida no es fiable (la\nteórica sirve de referencia). Es una medida indirecta (no mide temperatura bajo el agua); las boyas TAO están\ncaídas a ratos. Salida: registro/onda_kelvin.json","hoy":{"dia":"2026-11-25","frente_lon":-140,"velocidad_km_dia":49,"llegadas":{"galapagos_90O":{"km":5565,"con_velocidad_medida":"2027-03-18","con_velocidad_teorica":"2026-12-22"},"costa_82O":{"km":6455,"con_velocidad_medida":"2027-04-05","con_velocidad_teorica":"2026-12-26"}},"cambio_30d_cm_por_lon":{"-180":-3.0,"-178":-4.9,"-176":-7.3,"-174":-9.6,"-172":-8.5,"-170":-9.0,"-168":-7.4,"-166":-11.0,"-164":-10.5,"-162":-4.2,"-160":-9.0,"-158":-8.1,"-156":-8.9,"-154":-6.5,"-152":-7.6,"-150":-8.8,"-148":-7.4,"-146":-5.5,"-144":-7.2,"-142":-8.7,"-140":-9.8,"-138":-2.3,"-136":3.3,"-134":3.1,"-132":0.2,"-130":1.4,"-128":0.9,"-126":0.3,"-124":2.0,"-122":4.0,"-120":6.7,"-118":7.2,"-116":9.6,"-114":9.3,"-112":8.8,"-110":7.6,"-108":5.7,"-106":4.9,"-104":4.6,"-102":7.4,"-100":7.1,"-98":10.1,"-96":5.4,"-94":2.2,"-92":6.4,"-90":9.3,"-88":3.3,"-86":3.8,"-84":7.1,"-82":6.0}},"serie_frente":[["2026-11-01",-152],["2026-11-02",-152],["2026-11-03",-152],["2026-11-04",-152],["2026-11-05",-152],["2026-11-06",-152],["2026-11-07",-152],["2026-11-08",-152],["2026-11-09",-152],["2026-11-10",-152],["2026-11-11",-152],["2026-11-12",-150],["2026-11-13",-148],["2026-11-14",-148],["2026-11-15",-148],["2026-11-16",-148],["2026-11-17",-148],["2026-11-18",-148],["2026-11-19",-148],["2026-11-20",-148],["2026-11-21",-148],["2026-11-22",-150],["202